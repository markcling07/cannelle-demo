# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Signs the login cookies. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Where this site is reachable. Used for absolute links and SEO tags.
#   local:    http://localhost:3000
#   deployed: https://your-project.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PostgreSQL connection string from Neon (Dashboard -> Connection string).
# Leave this EMPTY to develop locally against a SQLite file instead.
# Must include ?sslmode=require for Neon.
DATABASE_URL=

# Vercel Blob read/write token, for storing product photographs.
# Vercel dashboard -> Storage -> Blob -> create store -> copy the token.
# Leave EMPTY to store uploads in the local ./media folder instead.
BLOB_READ_WRITE_TOKEN=

# Accounts created by `npm run seed`. All four are required.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
